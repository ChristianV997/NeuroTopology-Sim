{
  "schema_version": "1.0",
  "provenance_label": "local-smoke-matrix",
  "defaults": {
    "timeout_s": 60,
    "max_retries": 0,
    "optional_deps": []
  },
  "cases": [
    {
      "id": "orchestration-self-test",
      "command": ["python", "-c", "print('orchestration-ok')"],
      "timeout_s": 30,
      "tags": ["smoke", "local"],
      "config": {"purpose": "local smoke"}
    },
    {
      "id": "pytest-version",
      "command": ["python", "-m", "pytest", "--version"],
      "timeout_s": 30,
      "tags": ["smoke", "local"],
      "config": {"purpose": "verify pytest importable"}
    }
  ]
}
