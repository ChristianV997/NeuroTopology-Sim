{
  "$defs": {
    "pull_request": {
      "additionalProperties": true,
      "properties": {
        "base": {
          "additionalProperties": true,
          "properties": {
            "branch": {
              "type": "string"
            },
            "live_main_sha": {
              "$ref": "#/$defs/sha"
            },
            "sha": {
              "$ref": "#/$defs/sha"
            },
            "stale_against_live_main": {
              "type": "boolean"
            }
          },
          "required": [
            "branch",
            "sha",
            "stale_against_live_main",
            "live_main_sha"
          ],
          "type": "object"
        },
        "changed_path_count": {
          "minimum": 0,
          "type": "integer"
        },
        "changed_paths": {
          "items": {
            "$ref": "#/$defs/repo_path"
          },
          "type": "array",
          "uniqueItems": true
        },
        "ci": {
          "additionalProperties": true,
          "properties": {
            "experimental_suite_discovery": {
              "type": "string"
            },
            "observed_state": {
              "enum": [
                "pass",
                "fail",
                "pending",
                "unknown"
              ]
            },
            "required_check_reason": {
              "type": "string"
            },
            "required_check_state": {
              "enum": [
                "pass",
                "fail",
                "pending",
                "unknown",
                "not_applicable"
              ]
            },
            "required_checks_workflow_conclusion": {
              "type": [
                "string",
                "null"
              ]
            },
            "retrieved_at_utc": {
              "format": "date-time",
              "type": "string"
            },
            "workflow_runs": {
              "type": "array"
            }
          },
          "required": [
            "observed_state",
            "required_check_state",
            "required_check_reason",
            "required_checks_workflow_conclusion",
            "experimental_suite_discovery",
            "workflow_runs",
            "retrieved_at_utc"
          ],
          "type": "object"
        },
        "draft": {
          "type": "boolean"
        },
        "head": {
          "additionalProperties": true,
          "properties": {
            "branch": {
              "type": "string"
            },
            "sha": {
              "$ref": "#/$defs/sha"
            }
          },
          "required": [
            "branch",
            "sha"
          ],
          "type": "object"
        },
        "mergeability": {
          "additionalProperties": true,
          "properties": {
            "conflict_detail": {
              "type": "string"
            },
            "conflicting_paths": {
              "items": {
                "$ref": "#/$defs/repo_path"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "github_mergeable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "github_mergeable_state": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "github_mergeable",
            "github_mergeable_state",
            "conflicting_paths",
            "conflict_detail"
          ],
          "type": "object"
        },
        "number": {
          "minimum": 1,
          "type": "integer"
        },
        "readiness": {
          "additionalProperties": true,
          "properties": {
            "dependencies": {
              "type": "array"
            },
            "reasons": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "state": {
              "enum": [
                "ready",
                "draft",
                "blocked",
                "conflicted",
                "unknown"
              ]
            }
          },
          "required": [
            "state",
            "reasons",
            "dependencies"
          ],
          "type": "object"
        },
        "review": {
          "additionalProperties": true,
          "properties": {
            "approval_count": {
              "minimum": 0,
              "type": "integer"
            },
            "changes_requested_count": {
              "minimum": 0,
              "type": "integer"
            },
            "human_submission_count": {
              "minimum": 0,
              "type": "integer"
            },
            "retrieved_at_utc": {
              "format": "date-time",
              "type": "string"
            },
            "source_url": {
              "format": "uri",
              "type": "string"
            },
            "state": {
              "enum": [
                "approved",
                "human_comment_only",
                "automated_comment_only",
                "no_reviews",
                "unknown"
              ]
            },
            "submission_count": {
              "minimum": 0,
              "type": "integer"
            },
            "unresolved_inline_threads": {
              "enum": [
                "unknown"
              ]
            }
          },
          "required": [
            "state",
            "submission_count",
            "approval_count",
            "changes_requested_count",
            "human_submission_count",
            "unresolved_inline_threads",
            "source_url",
            "retrieved_at_utc"
          ],
          "type": "object"
        },
        "state": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "updated_at_utc": {
          "format": "date-time",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "number",
        "title",
        "url",
        "state",
        "draft",
        "updated_at_utc",
        "base",
        "head",
        "changed_paths",
        "changed_path_count",
        "mergeability",
        "review",
        "ci",
        "readiness"
      ],
      "type": "object"
    },
    "repo_path": {
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:[\\\\/]"
          },
          {
            "pattern": "(^|/)\\.\\.(?:/|$)"
          }
        ]
      },
      "type": "string"
    },
    "sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "$id": "https://github.com/ChristianV997/NeuroTopology-Sim/blob/main/docs/audits/live_repo_pr_ownership_map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "captured_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "ci_failure_groups": {
      "type": "array"
    },
    "evidence_retrieval_window_utc": {
      "additionalProperties": true,
      "properties": {
        "live_metadata_refreshed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "retrieval_timestamp_utc": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "retrieval_timestamp_utc",
        "live_metadata_refreshed"
      ],
      "type": "object"
    },
    "evidence_sources": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "claim": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "url",
          "claim"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "integration_dependencies": {
      "type": "array"
    },
    "integration_lanes": {
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "main_ci": {
      "additionalProperties": true,
      "properties": {
        "awareness_failure": {
          "type": "object"
        },
        "check_runs": {
          "type": "array"
        },
        "experimental_test_coverage": {
          "type": "string"
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "workflow_runs": {
          "type": "array"
        }
      },
      "required": [
        "head_sha",
        "workflow_runs",
        "check_runs",
        "awareness_failure",
        "experimental_test_coverage"
      ],
      "type": "object"
    },
    "ownership_summary": {
      "additionalProperties": true,
      "required": [
        "stale_base_pr_numbers",
        "stale_base_count",
        "path_collision_path_count",
        "pairwise_pr_collision_count",
        "observed_failed_pr_numbers",
        "observed_failed_pr_count",
        "ci_unknown_pr_numbers",
        "review_state_counts",
        "explicit_dependencies"
      ],
      "type": "object"
    },
    "path_collisions": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "classification": {
            "const": "exact_changed_path_overlap"
          },
          "git_conflict": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "interpretation": {
            "type": "string"
          },
          "path": {
            "$ref": "#/$defs/repo_path"
          },
          "pr_numbers": {
            "items": {
              "minimum": 1,
              "type": "integer"
            },
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "path",
          "pr_numbers",
          "classification",
          "git_conflict",
          "interpretation"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "pr_405": {
      "additionalProperties": true,
      "properties": {
        "base_sha": {
          "$ref": "#/$defs/sha"
        },
        "changed_paths": {
          "items": {
            "$ref": "#/$defs/repo_path"
          },
          "type": "array"
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "interface": {
          "type": "object"
        },
        "merge_commit_sha": {
          "$ref": "#/$defs/sha"
        },
        "merged": {
          "const": true
        },
        "number": {
          "const": 405
        },
        "source_url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "number",
        "state",
        "merged",
        "merge_commit_sha",
        "base_sha",
        "head_sha",
        "merged_at_utc",
        "changed_paths",
        "interface",
        "source_url"
      ],
      "type": "object"
    },
    "pull_requests": {
      "items": {
        "$ref": "#/$defs/pull_request"
      },
      "type": "array"
    },
    "readiness_summary": {
      "additionalProperties": true,
      "properties": {
        "assessment": {
          "type": "string"
        },
        "blocked_pr_numbers": {
          "type": "array"
        },
        "conflicted_pr_numbers": {
          "type": "array"
        },
        "counts": {
          "type": "object"
        },
        "draft_pr_numbers": {
          "type": "array"
        },
        "merge_ready_count": {
          "minimum": 0,
          "type": "integer"
        },
        "ready_pr_numbers": {
          "type": "array"
        },
        "unknown_pr_numbers": {
          "type": "array"
        }
      },
      "required": [
        "counts",
        "ready_pr_numbers",
        "draft_pr_numbers",
        "blocked_pr_numbers",
        "conflicted_pr_numbers",
        "unknown_pr_numbers",
        "merge_ready_count",
        "assessment"
      ],
      "type": "object"
    },
    "repository": {
      "additionalProperties": true,
      "properties": {
        "default_branch": {
          "type": "string"
        },
        "full_name": {
          "type": "string"
        },
        "html_url": {
          "format": "uri",
          "type": "string"
        },
        "main_sha": {
          "$ref": "#/$defs/sha"
        },
        "posture": {
          "const": "HOLD / SYNTHETIC_ONLY"
        },
        "remote_url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "full_name",
        "html_url",
        "remote_url",
        "default_branch",
        "main_sha",
        "posture"
      ],
      "type": "object"
    },
    "required_check_configuration": {
      "additionalProperties": true,
      "properties": {
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "retrieved_at_utc": {
          "format": "date-time",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "type": "string"
        },
        "state": {
          "enum": [
            "pass",
            "fail",
            "pending",
            "unknown",
            "not_applicable"
          ]
        }
      },
      "required": [
        "state",
        "reason",
        "source_url",
        "http_status",
        "retrieved_at_utc"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "neurotopology.live-repo-pr-ownership-map.v2"
    },
    "scope": {
      "additionalProperties": true,
      "properties": {
        "open_pr_count": {
          "minimum": 0,
          "type": "integer"
        },
        "open_pr_numbers": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "open_pr_state": {
          "const": "open"
        }
      },
      "required": [
        "open_pr_state",
        "open_pr_count",
        "open_pr_numbers"
      ],
      "type": "object"
    },
    "snapshot_kind": {
      "const": "timestamped_read_only_repository_and_pull_request_audit"
    }
  },
  "required": [
    "schema_version",
    "snapshot_kind",
    "captured_at_utc",
    "evidence_retrieval_window_utc",
    "repository",
    "scope",
    "required_check_configuration",
    "main_ci",
    "pull_requests",
    "path_collisions",
    "integration_dependencies",
    "integration_lanes",
    "ci_failure_groups",
    "readiness_summary",
    "ownership_summary",
    "pr_405",
    "evidence_sources",
    "limitations"
  ],
  "title": "Dated live repository and pull request ownership audit snapshot",
  "type": "object"
}
