# Runtime environment files are never part of a build context. The tracked
# Awareness template is intentionally retained; app .gitignore excludes .env.
**/.env
**/.env.*
!apps/awareness_studio/.env.example

# Common local cloud and CLI credential stores.
**/.aws/
**/.azure/
**/.config/gcloud/
**/.config/gh/
**/.ssh/
**/.kube/
**/.terraform.d/
**/.boto
**/.s3cfg
**/.docker/config.json
**/.npmrc
**/.pypirc
**/.netrc
**/.git-credentials
**/.envrc
**/credentials
**/credential
**/credentials.json
**/credentials.yaml
**/credentials.yml
**/credentials.toml
**/credentials.txt
**/credential.json
**/credential.yaml
**/credential.yml
**/credential.toml
**/credential.txt
**/*credentials*.json
**/*service-account*.json
**/*service_account*.json

# Private keys and certificate bundles must not cross the build boundary.
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.p12
**/*.p8
**/*.pfx
**/*.ppk
**/*.crt
**/*.cer
**/*.der
**/*.p7b
**/*.p7c
**/*.jks
**/*.kdb
